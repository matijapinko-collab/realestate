# ---------------------------------------------------------------------------
# Pinko web — environment variables
#
# Copy to .env.local for local work. Never commit a real .env file.
# Secrets must stay server-side: anything prefixed NEXT_PUBLIC_ is inlined into
# the browser bundle at build time, so no password ever goes there.
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical URLs, OG tags,
# sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexing is OFF unless this is exactly "true". Keep it unset on staging and
# previews so they can never be indexed.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Contact form (SMTP on the project's own cPanel hosting) ---------------
# All four are required for the form to send. If any is missing the form says
# so honestly and sends nothing; it never shows a fake success message.
#
# SMTP_HOST      cPanel mail host, e.g. mail.pinko.hr
# SMTP_PORT      465 for implicit TLS (default), or 587 for STARTTLS
# SMTP_USER      the full mailbox address, e.g. matija@pinko.hr
# SMTP_PASSWORD  that mailbox's password — secret, server-side only
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Where enquiries are delivered.
CONTACT_TO_EMAIL=matija@pinko.hr

# Envelope sender. Must be a mailbox on this domain or the server refuses to
# relay. Defaults to SMTP_USER when left empty. The visitor's own address is
# set as Reply-To, so replying from the inbox just works.
CONTACT_FROM_EMAIL=

# Public contact address shown on the site. Defaults to matija@pinko.hr.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Local development only ------------------------------------------------
# Renders unapproved project records so the layout can be reviewed. Has no
# effect in a production build.
NEXT_PUBLIC_SHOW_DRAFT_PROJECTS=false
